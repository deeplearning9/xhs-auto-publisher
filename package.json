{
  "name": "xhs-auto-publisher",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local, human-in-the-loop scheduler for publishing Xiaohongshu image notes.",
  "scripts": {
    "web": "node --env-file-if-exists=.env src/server.js",
    "login": "node src/cli.js login",
    "publish": "node src/cli.js publish",
    "daemon": "node src/cli.js daemon",
    "validate": "node src/cli.js validate",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "5.2.1",
    "multer": "2.2.0",
    "openai": "7.4.0",
    "playwright": "1.62.1",
    "undici": "^6.21.3"
  }
}
